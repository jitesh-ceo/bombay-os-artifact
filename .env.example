# JARVIS voice and brain. Copy to .env and fill in. Never commit .env.
# Without keys the demo still works: browser voice and scripted answers.

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID from https://elevenlabs.io/app/voice-library (a calm British male voice suits JARVIS)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
